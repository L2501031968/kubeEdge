#!/usr/bin/env bash
# 模拟 amari-mode：记录目标模式，不做真实重启。
set -euo pipefail

STATE_DIR="${KB_SIM_STATE:-/var/lib/kb-sim}"
STATE_FILE="$STATE_DIR/amari-mode"

usage() {
  echo "用法: amari-mode <status|edge|local>" >&2
  exit 2
}

if [ "$#" -lt 1 ]; then
  usage
fi

mkdir -p "$STATE_DIR" 2>/dev/null || true

case "$1" in
  status)
    if [ -f "$STATE_FILE" ]; then
      echo "[sim] 当前模式: $(cat "$STATE_FILE")"
    else
      echo "[sim] 当前模式: unknown"
    fi
    ;;
  edge)
    printf 'edge-container\n' > "$STATE_FILE"
    echo "[sim] 已切换到边缘容器模式（模拟：真实设备会重启 EdgeCore 侧容器）"
    ;;
  local)
    printf 'local\n' > "$STATE_FILE"
    echo "[sim] 已切换到本地模式（模拟：真实设备会重启整机，失控属正常）"
    ;;
  *)
    usage
    ;;
esac
