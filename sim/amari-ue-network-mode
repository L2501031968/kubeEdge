#!/usr/bin/env bash
# 模拟 amari-ue-network-mode：记录 UE 网络模式。
set -euo pipefail

STATE_DIR="${KB_SIM_STATE:-/var/lib/kb-sim}"
STATE_FILE="$STATE_DIR/ue-network-mode"

usage() {
  echo "用法: amari-ue-network-mode <bridge|direct>" >&2
  exit 2
}

if [ "$#" -lt 1 ]; then
  usage
fi

mkdir -p "$STATE_DIR" 2>/dev/null || true

case "$1" in
  bridge|direct)
    printf '%s\n' "$1" > "$STATE_FILE"
    echo "[sim] UE 网络模式已设置为 $1（模拟）"
    ;;
  status)
    cat "$STATE_FILE" 2>/dev/null || echo "unknown"
    ;;
  *)
    usage
    ;;
esac
