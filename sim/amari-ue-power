#!/usr/bin/env bash
# 模拟 amari-ue-power：只把状态写进状态目录，用于虚拟机联调。
set -euo pipefail

STATE_DIR="${KB_SIM_STATE:-/var/lib/kb-sim}"
STATE_FILE="$STATE_DIR/ue-power"

usage() {
  echo "用法: amari-ue-power <on|off|status> [编号]" >&2
  exit 2
}

if [ "$#" -lt 1 ]; then
  usage
fi

action="$1"
index="${2:-1}"

mkdir -p "$STATE_DIR" 2>/dev/null || true

case "$action" in
  on)
    printf 'on\n' > "$STATE_FILE"
    echo "[sim] UE ${index} 已上电（模拟，不会触碰真实 SDR）"
    ;;
  off)
    printf 'off\n' > "$STATE_FILE"
    echo "[sim] UE ${index} 已下电（模拟）"
    ;;
  status)
    if [ -f "$STATE_FILE" ]; then
      cat "$STATE_FILE"
    else
      echo "unknown"
    fi
    ;;
  *)
    usage
    ;;
esac
